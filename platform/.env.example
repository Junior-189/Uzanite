# ── UZANITE platform (NestJS) ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL (system of record for migrated domains).
# In production the APPLICATION must connect as a NON-owner, NOBYPASSRLS role
# (e.g. uzanite_app) so Row Level Security is enforced. Migrations run as the
# owner via a separate URL. See apps/api/prisma/sql/ci-roles.sql.
#
# Scaling: size the pool per replica. Keep (replicas * connection_limit) below
# the Postgres max_connections budget; front with PgBouncer for many replicas.
#   ?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://uzanite_app:change-me@localhost:5432/uzanite?schema=public&connection_limit=10&pool_timeout=20

# Redis is REQUIRED in production (shared rate limits, lockouts, BullMQ queues).
REDIS_URL=redis://localhost:6379

# Auth (HS256). REQUIRED: at least 32 chars and NOT a placeholder/example value.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Secrets at rest (per-tenant Meta tokens). REQUIRED in production.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

APP_URL=http://localhost:4000
# Used by the worker for links in outbound email (falls back to nothing if unset).
PUBLIC_APP_URL=http://localhost:4000
LOG_LEVEL=info

# CORS allow-list. In production this must be explicit https origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Row Level Security. Must be "true" in production (requires the non-owner role).
RLS_ENABLED=false

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Number of trusted proxies in front of the API. LOAD-BEARING FOR SECURITY: the
# rate limiter and login lockout derive the client identity from req.ip, so if
# this is wrong every request behind the proxy shares one bucket and abuse
# protection stops working. 1 = a single nginx/ALB. 0 = direct exposure.
TRUST_PROXY_HOPS=1

# ── Caching (read-through, Redis) ────────────────────────────────────────────
# Seconds. These two reads are on 100% of authenticated traffic, so caching
# them is the single largest database saving available. 0 disables a cache.
# Writes invalidate explicitly; the short TTL bounds any missed invalidation.
CACHE_MEMBERSHIP_TTL=60
CACHE_BILLING_TTL=60

# ── Outbound third-party calls ───────────────────────────────────────────────
# Hard ceiling on every outbound provider HTTP call (ms). Node's fetch has no
# useful default, so without this a hung payment provider holds request slots
# for minutes. A circuit breaker opens after 5 consecutive failures.
PROVIDER_TIMEOUT_MS=8000

# ── PostgreSQL guard rails ───────────────────────────────────────────────────
# The API VERIFIES these at boot and warns if they are unset; it does not set
# them. Apply them on the server (see docker-compose.yml), in the connection
# string (`?options=-c%20statement_timeout%3D15000`), or via ALTER ROLE.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=15000

# ── Data retention (PDPA). Worker sweep; 0 disables an individual table. ─────
# Financial records (orders, payments, ledger, journals, receipts) are NEVER
# swept — a business must retain them. Customer PII inside them is handled by
# the erasure endpoint, which pseudonymises rather than deletes.
RETENTION_INTERVAL_MS=86400000
RETENTION_BATCH_SIZE=5000
RETENTION_FLOW_TRACE_DAYS=90
RETENTION_WEBHOOK_EVENT_DAYS=30
RETENTION_LOGIN_ATTEMPT_DAYS=90
RETENTION_ACTIVITY_LOG_DAYS=365

# Protect GET /api/v1/metrics (header `x-metrics-token` or `?token=`).
# When unset, /metrics is denied in production.
METRICS_TOKEN=

# ── Observability (optional) ─────────────────────────────────────────────────
# Sentry-compatible error tracking (Store API; no SDK required). Empty = log only.
SENTRY_DSN=
APP_RELEASE=
# W3C trace context is always enabled; OTLP/HTTP span export is opt-in.
OTEL_SERVICE_NAME=uzanite-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# Worker: ledger reconciliation sweep interval in ms (default 900000 = 15 min).
RECONCILE_INTERVAL_MS=900000

# Seed (prisma:seed). Leave empty to skip super-admin bootstrap; if set, the
# password must be strong (>=12 chars, not a known default) and is changed on
# first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Meta WhatsApp Cloud API (optional — messaging endpoints are disabled without them)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
WHATSAPP_FLOW_MODE=off

# SMTP (optional — email is logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=UZANITE <no-reply@uzanite.local>

# ── M13: proxy awareness ─────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the API. LOAD-BEARING FOR
# SECURITY: the Redis rate limiter and the login lockout derive their keys from
# req.ip. With this wrong, every request behind the gateway shares one bucket,
# so abuse is indistinguishable from normal traffic and one noisy client can
# 429 every tenant. 1 = a single nginx/ALB. 0 = direct exposure, no proxy.
TRUST_PROXY_HOPS=1

# ── M13: read-through cache TTLs (seconds; 0 disables) ───────────────────────
# The membership lookup runs on 100% of authenticated requests and the
# entitlement snapshot on every plan-guarded route. Both are invalidated
# explicitly on write; the short TTL bounds staleness if one is ever missed.
CACHE_MEMBERSHIP_TTL=60
CACHE_BILLING_TTL=60

# ── M13: outbound provider calls ─────────────────────────────────────────────
# Hard ceiling on any third-party HTTP call (ClickPesa, AzamPay, Meta, Sentry).
# Node's fetch has no useful default, so a hung provider used to hold a request
# slot for minutes and the API stopped accepting traffic under provider
# degradation. A circuit breaker opens after 5 consecutive failures.
PROVIDER_TIMEOUT_MS=8000

# ── M13: PostgreSQL guard rails (milliseconds; 0 disables) ───────────────────
# Applied with ALTER ROLE at boot so every pooled connection inherits them.
# Without these, one pathological query holds a connection and its row locks
# indefinitely — the usual way a single slow endpoint takes down a healthy API.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=15000

# ── M13: data retention (days; 0 disables that sweep) ────────────────────────
# PDPA expects personal data to be kept only as long as needed. The worker
# sweeps these daily in bounded batches. Financial records (orders, payments,
# ledger, journals, receipts) are NEVER swept — a business must retain them, and
# customer PII inside them is handled by the erasure endpoint instead.
RETENTION_FLOW_TRACE_DAYS=90
RETENTION_WEBHOOK_EVENT_DAYS=30
RETENTION_LOGIN_ATTEMPT_DAYS=90
RETENTION_ACTIVITY_LOG_DAYS=365
RETENTION_BATCH_SIZE=5000

# ── M13: backups (used by scripts/backup-postgres.sh) ────────────────────────
# Backups contain every tenant's customer PII and financial records, so an
# unencrypted archive is a breach waiting for a misconfigured bucket.
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
