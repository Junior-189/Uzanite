# Local dev frontend env (copy to client/.env for development)
# Base API URL (use /api when served behind the same origin as the backend)
VITE_API_URL=/api

# Google OAuth client ID (Web application). Must match GOOGLE_CLIENT_ID in the
# server .env. If empty/unset, the "Sign in with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Strangler cutover (leave OFF until the NestJS platform is deployed) ──────
# Base URL the migrated wave-1 domains are served from once enabled.
VITE_PLATFORM_API_URL=/api/v1
# When "true", migrated domain calls are routed to the platform and their
# responses adapted to the legacy client shape. Default/unset = all traffic
# stays on the legacy `/api`. Enable per environment AFTER running the parity
# harness (platform/scripts/api-parity-check.mjs) to green.
VITE_API_V1=false

# Optional per-domain rollout: comma-separated subset (bare or rooted), e.g.
# "auth,billing" or "/auth,/billing". When set, ONLY these domains route to the
# platform; everything else stays legacy. Unset = every migrated domain above.
# Use this to widen or roll back the cutover one domain at a time without a code
# change. See docs/CUTOVER_PLAYBOOK.md.
VITE_API_V1_DOMAINS=
