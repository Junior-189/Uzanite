# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/whatsapp_saas?retryWrites=true&w=majority

# Auth
# REQUIRED. The server refuses to start if this is missing, shorter than 32
# chars, or a known placeholder. Generate one with: openssl rand -hex 32
# Rotate by issuing a new value and redeploying (all existing sessions are
# invalidated, which is expected and desirable).
JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API.
# Native apps / same-origin requests send no Origin and are always allowed.
CORS_ORIGINS=https://uzanite.shop,https://www.uzanite.shop,http://localhost:5173,http://localhost:3000

# Google OAuth (Sign in with Google)
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Add your app origins (e.g. http://localhost:3000 and your domain) under
# "Authorized JavaScript origins". Use the same value for VITE_GOOGLE_CLIENT_ID (client).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server
PORT=3000
NODE_ENV=production

# WhatsApp
ADMIN_PHONE=255700000000

# Business
BUSINESS_NAME=Your Business Name
BUSINESS_ID=default

# Payment Details
MPESA_NUMBER=255700000000
MPESA_NAME=Business Owner
TIGO_NUMBER=255600000000
AIRTEL_NUMBER=255680000000

# ── WhatsApp transport (Phase 2) ─────────────────────────────────────────────
# 'meta' (default, official Cloud API) or 'baileys' (legacy, off by default).
WHATSAPP_TRANSPORT=meta
META_GRAPH_VERSION=v21.0
# Platform-level Meta app secret + verify token. The /webhook endpoint is
# DISABLED unless BOTH are set. META_APP_SECRET verifies the
# X-Hub-Signature-256 HMAC on every inbound webhook.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Per-tenant credentials (phone_number_id, WABA id, access token) are stored
# encrypted via the API (POST /api/whatsapp/meta/credentials) using this key.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Payments (Phase 3) ───────────────────────────────────────────────────────
# Default provider: manual | clickpesa | azampay. Non-manual providers are only
# enabled when their credentials are set; manual confirmation always works.
PAYMENTS_DEFAULT_PROVIDER=manual
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_WEBHOOK_SECRET=
AZAMPAY_BASE_URL=https://authenticator.azampay.co.tz
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_WEBHOOK_SECRET=

# ── Private object storage (Phase 3) ─────────────────────────────────────────
# provider: local (default) or s3 (Cloudflare R2 / AWS S3 / MinIO).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=private_uploads
# HMAC secret for local signed URLs. Generate with: openssl rand -hex 32
STORAGE_SIGNING_SECRET=
STORAGE_URL_TTL_SECONDS=900
# 0 = keep forever; otherwise purge private objects after N days.
STORAGE_RETENTION_DAYS=0
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Background jobs (Phase 2) ────────────────────────────────────────────────
# Set REDIS_URL to use BullMQ + Redis. If unset, an in-process fallback queue is
# used (fine for dev/tests; not for multi-instance production).
REDIS_URL=
# When Redis is configured, run a dedicated worker with `npm run worker` and set
# this to 'false' so the API process does not also run workers.
RUN_WORKER_IN_PROCESS=true

# Secure bootstrap for the super-admin account (scripts/seedSuperAdmin.js).
# Never commit real values. The account is forced to change its password on first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email (Gmail SMTP) — set EMAIL_USER + 16-char Gmail App Password to enable.
# Generate an App Password at Google Account > Security > 2-Step Verification > App passwords.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=UZANITE <no-reply@uzanite.app>
EMAIL_ADMIN=admin@yourdomain.com
APP_URL=https://uzanite.shop
APP_NAME=UZANITE
