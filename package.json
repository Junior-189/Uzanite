{
  "name": "uzanite",
  "version": "1.0.0",
  "description": "UZANITE — Multi-tenant WhatsApp commerce + POS for Tanzanian SMEs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node src/worker.js",
    "dev": "nodemon server.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:install": "cd client && npm install",
    "electron:dev": "electron .",
    "electron:build": "npm run client:build && npx electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:phase0": "node scripts/migrate-phase0.js",
    "migrate:phase1": "node scripts/migrate-phase1-indexes.js",
    "seed:admin": "node scripts/seedSuperAdmin.js"
  },
  "build": {
    "appId": "com.uzer.desktop",
    "productName": "UZANITE",
    "directories": {
      "output": "dist-electron",
      "app": "electron"
    },
    "files": [
      "**/*",
      "!node_modules"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UZANITE",
      "artifactName": "UZANITE-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.3",
    "pdf-to-img": "^7.0.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.2.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "@types/node": "^20.17.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
